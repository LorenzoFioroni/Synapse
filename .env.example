# Copy to .env (never committed) and fill in. See docs/docker.md.

# The HTTPS address the tunnel serves Synapse at. Passkeys belong to this name: keep it.
SYNAPSE_PUBLIC_URL=https://synapse.example.com

# Cloudflare dashboard → Zero Trust → Networks → Tunnels → your tunnel → the token of its install command.
TUNNEL_TOKEN=

# The time zone of plugin schedules and backups (default UTC).
TZ=Europe/Zurich

# The library folder on the host, and its owner (id -u / id -g).
SYNAPSE_DATA=./data
SYNAPSE_UID=1000
SYNAPSE_GID=1000

# Where the code comes from: this checkout (the default), or a Git repository to build. With a GitHub
# repository Settings → Updates also checks it for newer commits (docs/updates.md).
#SYNAPSE_SOURCE=https://github.com/owner/Synapse.git#main
# Update Now in Settings: the updater profile, a random token (openssl rand -hex 32) and this
# folder's absolute path (pwd).
#SYNAPSE_UPDATER_TOKEN=
#UPDATER_PROJECT_DIR=/path/to/this/folder

# Ollama for Autocompletion (then: docker compose exec ollama ollama pull qwen2.5-coder:1.5b), and
# the updater:
#COMPOSE_PROFILES=ollama,updater
# ... on an NVIDIA GPU:
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
