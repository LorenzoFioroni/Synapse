{
  "name": "synapse-frontend",
  "private": true,
  "description": "Build of the Synapse web app: TypeScript in src/ is compiled to js/ (not committed). The @codemirror, @lezer, katex, markdown-it (@types) and force-graph packages are here for their types only: the app uses the bundles in vendor/ (built by tools/), pinned to the same versions.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.4",
    "@lezer/markdown": "1.7.2",
    "@types/markdown-it": "14.2.0",
    "esbuild": "0.28.2",
    "force-graph": "1.51.4",
    "katex": "0.18.9",
    "pdfjs-dist": "3.4.120",
    "typescript": "5.9.3"
  }
}
