# Everything needed to work on Synapse: the app's own dependencies plus the test and lint tools.
# Edit here, then run python tools/lock_requirements.py.
# Runtime constraints keep CI and server installs on the same dependency versions.
-r requirements.in
-c requirements.txt
pytest>=9.0.3
pytest-cov>=5   # coverage: python -m pytest --cov
mypy>=1.10      # type check: mypy (settings in pyproject.toml)
ruff>=0.15
pyyaml>=6      # validates the generated Claude agent frontmatter in tests
# Patched filelock (a virtualenv/pre-commit dependency) requires Python 3.11+.
# Synapse and its test/lint tools still support 3.10; optional hooks use a newer interpreter.
pre-commit>=4 ; python_version >= '3.11'
