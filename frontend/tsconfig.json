{
  // Type checking only (npm run check); build.mjs compiles with esbuild.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": { "@codemirror/*": ["node_modules/@codemirror/*"], "force-graph": ["node_modules/force-graph"], "markdown-it": ["node_modules/@types/markdown-it/index.d.mts"] },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "../plugins/autocompletion/frontend", "../plugins/metadata-check/frontend", "../plugins/graph/frontend", "../plugins/extended-markdown/frontend", "../plugins/tasks/frontend"]
}
