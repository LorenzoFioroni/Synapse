# Copy to .env (never committed) and fill in. See docs/docker.md.

# The HTTPS address the tunnel serves Synapse at. Passkeys belong to this name: keep it.
SYNAPSE_PUBLIC_URL=https://synapse.example.com

# Cloudflare dashboard → Zero Trust → Networks → Tunnels → your tunnel → the token of its install command.
TUNNEL_TOKEN=

# The time zone of plugin schedules and backups (default UTC).
TZ=Europe/Zurich

# The library folder on the host, and its owner (id -u / id -g).
SYNAPSE_DATA=./data
SYNAPSE_UID=1000
SYNAPSE_GID=1000

# Ollama for Autocompletion (then: docker compose exec ollama ollama pull qwen2.5-coder:1.5b).
#COMPOSE_PROFILES=ollama
# ... on an NVIDIA GPU:
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
